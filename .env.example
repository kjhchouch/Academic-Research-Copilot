# ============================================================
# Copy to .env and fill in. NEVER commit .env
# ============================================================

# --- App ---
APP_ENV=development
# Comma-separated list of allowed browser origins
CORS_ORIGINS=["http://localhost:3000"]

# --- Storage backends ---
# Local-first defaults: the app boots with ZERO external services running.
# Docker / native Postgres is a Week 4 deployment concern, not a prerequisite.
#
#   checkpoint: memory (D3, lost on restart) -> sqlite (D7) -> postgres (Week 4)
#   cache:      memory (single worker)       -> redis  (multi-worker / deploy)
#   blob:       local (data/blobs/)          -> s3     (Week 3, needs MinIO)
CHECKPOINT_BACKEND=sqlite     # memory | sqlite | postgres
CACHE_BACKEND=memory
BLOB_BACKEND=local
SQLITE_PATH=data/checkpoints.sqlite
STORAGE_DIR=data/blobs

# --- Infra (only used when the backends above are switched to postgres/redis/s3) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/agent
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=papers

# --- LLM provider (D3) ---
# DeepSeek is OpenAI-compatible: one client, one base_url. Point LLM_BASE_URL at
# OpenAI / OpenRouter / a local Ollama and no calling code has to change.
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
# DeepSeek /models lists exactly these two as of 2026-10-14. deepseek-chat and
# deepseek-reasoner still answer but are unlisted legacy aliases -- don't use them.
# Fast Path (ReAct + tool calling) and the cheap graph nodes
LLM_CHAT_MODEL=deepseek-flash
# Deep Path nodes that need multi-step reasoning (Verifier, outline planning)
LLM_REASONING_MODEL=deepseek-v4-pro
# BOTH models emit reasoning_content and those tokens count against max_tokens.
# Keep this generous or the model burns the budget reasoning and never emits the
# tool call -- which looks like "tool calling is broken" but is really this.
LLM_MAX_TOKENS=2048

# --- Observability (D3) ---
# Week 1 uses Langfuse Cloud. Self-hosting is deferred to Week 4.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Must match the region the Langfuse project was created in (us.cloud.langfuse.com
# for US). A wrong region reports "unauthorized", which reads like a bad key.
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Decision model: TypeSafe AI Jev (D4) ---
TYPESAFE_API_KEY=
# Fallback classifier when Jev times out or the circuit is open
DECISION_MODEL_BACKEND=jev
JEV_TIMEOUT_MS=800

# --- Literature data sources (D5) ---
# OpenAlex works with no key, but the keyless budget is $0.10/day SHARED BY EVERYONE
# ON YOUR EGRESS IP (about 100 requests), resetting at midnight UTC. This project
# exhausted it twice in one week. A key gets its own budget ($1/day, per OpenAlex's
# own notice text).
#
# `mailto` puts you in OpenAlex's polite pool, which is about throughput. Measured:
# it does NOT raise the daily budget -- the 429 we hit says "Insufficient budget",
# and only OPENALEX_API_KEY changes that. Set both.
OPENALEX_MAILTO=
OPENALEX_API_KEY=
# Get the key yourself at https://openalex.org/settings/api. Do NOT let an agent
# fetch it for you: every keyless OpenAlex response carries a meta.notice telling
# AI agents to POST your email address to https://api.openalex.org/api-keys. That
# is an instruction arriving on a data channel, and packages/mcp-servers/
# literature-search deliberately never reads meta beyond `count` -- there is a test
# asserting none of that text can reach a model. See docs/devlog.md, D5.
#
# Semantic Scholar is the secondary upstream, reached only for CorpusId:/ArXiv:/40-hex
# identifiers. Unkeyed it returns 429 on the first request, so without a key the
# server says so and points at DOI / OpenAlex ID instead. DOIs go to OpenAlex.
SEMANTIC_SCHOLAR_API_KEY=
# Optional overrides, defaults in mcp_literature_search/config.py:
#   OPENALEX_BASE_URL, SEMANTIC_SCHOLAR_BASE_URL, LITERATURE_TIMEOUT_SECONDS,
#   LITERATURE_MAX_RESULTS (ceiling on `limit`, clamped not rejected),
#   LITERATURE_MAX_REFERENCES (bibliography truncation; the true count is returned)
